+// B4: gather the K most frequent rows of the (tied) LM head into a small matrix used only by the MTP draft graph.
+// LLAMA_MTP_TRIM_FILE = text file, one token id per line, most frequent first; LLAMA_MTP_TRIM_K = rows to keep.
+// The target model's logits / verification are untouched; draft ids are mapped back with llama_model_mtp_trim_map().
+void llama_model_base::load_tensors_mtp_trim() {
+    const char * path = getenv("LLAMA_MTP_TRIM_FILE");
+    if (!path || hparams.n_layer_nextn == 0 || arch != LLM_ARCH_QWEN35) {
+        return;
+    }
+    const char * ks = getenv("LLAMA_MTP_TRIM_K");
+    const int64_t n_vocab = vocab.n_tokens();
+    const size_t  K_req   = ks ? (size_t) strtoull(ks, nullptr, 10) : 0;
+    const auto & layer = layers[hparams.n_layer()];
+    const ggml_tensor * head = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : output;
+    if (!head || !head->buffer || head->ne[1] != n_vocab || K_req == 0 || (layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s : output_s)) {
+        LLAMA_LOG_WARN("%s: MTP trim requested but not applicable\n", __func__);
+        return;
+    }
+
+    std::vector<int32_t> ids;
+    std::vector<char> seen(n_vocab, 0);
+    {
+        std::ifstream f(path);
+        long long v;
+        while (ids.size() < K_req && (f >> v)) {
+            if (v >= 0 && v < n_vocab && !seen[v]) { seen[v] = 1; ids.push_back((int32_t) v); }
+        }
+    }
+    const int64_t K = (int64_t) ids.size();
+    if (K < 16) {
+        LLAMA_LOG_WARN("%s: MTP trim file gave only %d ids, ignoring\n", __func__, (int) K);
+        return;
+    }
+
+    const size_t row_bytes = ggml_row_size(head->type, head->ne[0]);
+    std::vector<uint8_t> all(ggml_nbytes(head)), sub((size_t) K * row_bytes);
+    ggml_backend_tensor_get(head, all.data(), 0, all.size());
+    for (int64_t k = 0; k < K; ++k) {
+        memcpy(sub.data() + (size_t) k * row_bytes, all.data() + (size_t) ids[k] * row_bytes, row_bytes);
+    }
+    std::vector<float> mask(n_vocab, -INFINITY);
+    std::fill(mask.begin(), mask.begin() + K, 0.0f);
+
+    ggml_init_params ip = { 2*ggml_tensor_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * t_sub  = ggml_new_tensor_2d(ctx, head->type, head->ne[0], K);
+    ggml_tensor * t_mask = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_vocab);
+    ggml_set_name(t_sub,  "mtp_head_sub");
+    ggml_set_name(t_mask, "mtp_head_mask");
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_buffer_get_type(head->buffer));
+    if (!buf) {
+        ggml_free(ctx);
+        LLAMA_LOG_WARN("%s: MTP trim buffer allocation failed\n", __func__);
+        return;
+    }
+    ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_tensor_set(t_sub,  sub.data(),  0, sub.size());
+    ggml_backend_tensor_set(t_mask, mask.data(), 0, mask.size()*sizeof(float));
+
+    std::vector<ggml_backend_buffer_ptr> bufs;
+    bufs.emplace_back(buf);
+    pimpl->ctxs_bufs.emplace_back(ggml_context_ptr(ctx), std::move(bufs));
+
+    mtp_head_sub  = t_sub;
+    mtp_head_mask = t_mask;
+    mtp_trim_map  = std::move(ids);
+    LLAMA_LOG_INFO("%s: MTP draft head trimmed to %d / %d tokens (%.1f MiB, buffer %s)\n", __func__, (int) K, (int) n_vocab,
+        sub.size() / 1024.0 / 1024.0, ggml_backend_buffer_name(buf));
+}
+
+const int32_t * llama_model_mtp_trim_map(const struct llama_model * model, int32_t * n) {
+    if (n) { *n = (int32_t) model->mtp_trim_map.size(); }
+    return model->mtp_trim_map.empty() ? nullptr : model->mtp_trim_map.data();
+}
+
